import Huffman

HuffmanTest := [].{
	placeholder : U8
	placeholder = 0
}

## Render a built code the way libdeflate's oracle prints it, so the two
## can be compared directly: one "<sym> <len> <codeword>" line per used symbol.
render : List(U32), U64 -> Str
render = |freqs, max_len| {
	code = Huffman.build(freqs, max_len)
	n = List.len(freqs)
	var $out = ""
	var $i = 0.U64
	while $i < n {
		len = List.get(code.lengths, $i) ?? 0
		if len != 0 {
			cw = List.get(code.codewords, $i) ?? 0
			$out = "${$out}${$i.to_str()} ${len.to_str()} ${cw.to_str()}\n"
		} else {
		}
		$i = $i + 1
	}
	$out
}

# Generated by comparing against libdeflate's own deflate_make_huffman_code
# (benchmark/c/oracle/huffman_oracle.c). Every expected value below is what
# libdeflate produces for those frequencies, so a drift in either the code
# lengths or the canonical codewords fails here.

